PORT=3001
APP_URL=http://localhost:5174
# Server only. Supabase PostgreSQL session-pooler connection (port 5432).
# Never prefix database credentials with VITE_.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_DATABASE_PASSWORD@POOLER_HOST:5432/postgres
QUEUECARE_ADMIN_EMAIL=admin@queuecare.local
# Required only when creating the initial admin; use a strong unique password.
QUEUECARE_ADMIN_PASSWORD=
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
